# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/murmur?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/murmur?retryWrites=true&w=majority

# Groq API key — get from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
